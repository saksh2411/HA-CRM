Options -Indexes
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L,QSA]
<FilesMatch "^(\.env|composer\.(json|lock)|package(-lock)?\.json|database\.(sql|php)|README\.md|IMPLEMENTATION_DECISIONS\.md)$">
  Require all denied
</FilesMatch>
